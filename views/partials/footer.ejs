  <footer class="footer" id="footer">
    <div class="container footer-grid">
      <div class="footer-col">
        <h3><%= settings && settings.festivalName ? settings.festivalName : 'Electrofest' %></h3>
        <p><%= settings && settings.footerText ? settings.footerText : 'Eşsiz bir elektro müzik deneyimi.' %></p>
      </div>
      <div class="footer-col">
        <h4>Hızlı Bağlantılar</h4>
        <ul>
          <li><a href="#section-schedule">Program</a></li>
          <li><a href="#section-tickets">Biletler</a></li>
          <li><a href="#section-gallery">Galeri</a></li>
          <li><a href="#section-videos">Video Feed</a></li>
          <li><a href="#section-sponsors">Sponsorlar</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>İletişim</h4>
        <% if (settings && settings.contactAddress) { %><p><%= settings.contactAddress %></p><% } %>
        <% if (settings && settings.contactPhone) { %><p><a href="tel:<%= String(settings.contactPhone).replace(/[^\d+]/g, '') %>"><%= settings.contactPhone %></a></p><% } %>
        <% if (settings && settings.contactEmail) { %><p><a href="mailto:<%= settings.contactEmail %>"><%= settings.contactEmail %></a></p><% } %>
      </div>
      <div class="footer-col">
        <h4>Bülten</h4>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="E-posta adresiniz" aria-label="E-posta">
          <button type="submit" class="btn-cta">Abone Ol</button>
        </form>
        <div class="social-links">
          <% if (settings && settings.socialFacebook) { %><a href="<%= settings.socialFacebook %>" target="_blank" rel="noopener">Facebook</a><% } %>
          <% if (settings && settings.socialInstagram) { %><a href="<%= settings.socialInstagram %>" target="_blank" rel="noopener">Instagram</a><% } %>
          <% if (settings && settings.socialTwitter) { %><a href="<%= settings.socialTwitter %>" target="_blank" rel="noopener">Twitter</a><% } %>
          <% if (settings && settings.socialYoutube) { %><a href="<%= settings.socialYoutube %>" target="_blank" rel="noopener">YouTube</a><% } %>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> <%= settings && settings.festivalName ? settings.festivalName : 'Electrofest' %>. Tüm hakları saklıdır.</p>
    </div>
  </footer>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" id="lightboxClose" aria-label="Kapat">&times;</button>
    <img src="" alt="" id="lightboxImg">
    <p id="lightboxCaption"></p>
  </div>

  <%
    const rawPhone = settings && settings.contactPhone ? String(settings.contactPhone) : '';
    const rawWhatsapp = settings && settings.contactWhatsapp ? String(settings.contactWhatsapp) : rawPhone;
    const telDigits = rawPhone.replace(/[^\d+]/g, '');
    let waDigits = rawWhatsapp.replace(/\D/g, '');
    if (waDigits.startsWith('0')) waDigits = '90' + waDigits.slice(1);
    const waMessage = encodeURIComponent('Merhaba, festival hakkında bilgi almak istiyorum.');
  %>
  <% if (telDigits || waDigits) { %>
    <div class="contact-fab" role="navigation" aria-label="Hızlı iletişim">
      <% if (waDigits) { %>
        <a
          class="contact-fab__btn contact-fab__btn--whatsapp"
          href="https://wa.me/<%= waDigits %>?text=<%= waMessage %>"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp ile yazın"
        >
          <svg class="contact-fab__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="contact-fab__label">WhatsApp</span>
        </a>
      <% } %>
      <% if (telDigits) { %>
        <a
          class="contact-fab__btn contact-fab__btn--call"
          href="tel:<%= telDigits %>"
          aria-label="Telefon ile ara"
        >
          <svg class="contact-fab__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M6.62 10.79a15.15 15.15 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.4 21 3 13.6 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span class="contact-fab__label">Ara</span>
        </a>
      <% } %>
    </div>
  <% } %>

  <script src="/js/main.js"></script>
</body>
</html>
